# Copie este arquivo para .env.local e preencha.
# Na Vercel, cadastre em Settings > Environment Variables.
#
# ATENÇÃO: variáveis NEXT_PUBLIC_ são embutidas no bundle durante o build.
# Depois de cadastrar ou alterar qualquer uma delas, é obrigatório fazer um
# novo deploy, senão elas chegam vazias no navegador.

# ID da conta do Google Ads, no formato AW-XXXXXXXXX.
# Onde achar: Google Ads > Ferramentas > Conversões > Tag do Google.
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Rótulos das duas ações de conversão criadas no Google Ads.
# Ao criar a conversão, o Google mostra send_to: 'AW-XXXXXXXXX/AbCdEfGhIj'.
# Aqui vai só a parte depois da barra.
NEXT_PUBLIC_GOOGLE_ADS_LABEL_FORM=
NEXT_PUBLIC_GOOGLE_ADS_LABEL_WHATSAPP=

# URL do Web App do Apps Script que grava os leads na planilha.
# Termina em /exec. Passo a passo em docs/campanha/planilha.md.
NEXT_PUBLIC_FORM_ENDPOINT=
